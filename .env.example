# Choose one provider and use a current model ID from its model catalog.
AI_PROVIDER=openrouter
AI_MODEL=provider/model-id

# Set the key for the selected provider only.
OPENROUTER_API_KEY=
CRUSOE_API_KEY=

# Optional voice-to-text prototype using ElevenLabs Scribe v2.
ELEVENLABS_API_KEY=

# Optional Neo4j memory graph. Local database: `docker compose up -d`, then `npm run memory:seed`.
# The password below is the local-development default from docker-compose.yml.
# For AuraDB use the neo4j+s:// URI and credentials from the Aura console.
# NEO4J_URI=bolt://localhost:7687
# NEO4J_USERNAME=neo4j
# NEO4J_PASSWORD=emori-local-dev
# NEO4J_DATABASE=

# Optional: point the compatible adapter at another endpoint or local test server.
# AI_BASE_URL=https://api.example.com/v1

# Optional OpenRouter attribution headers.
OPENROUTER_APP_NAME=Emori
APP_URL=http://localhost:3000

# Optional Sentry error tracking (@sentry/nextjs). Leave empty to disable Sentry entirely.
# Server/edge use SENTRY_DSN; the browser uses NEXT_PUBLIC_SENTRY_DSN (inlined at build time).
# Both are the same project DSN. Set them in Vercel project env, never commit values.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
# Fraction of requests traced (0.0 to 1.0). Empty = 0.05.
# SENTRY_TRACES_SAMPLE_RATE=
# NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=
