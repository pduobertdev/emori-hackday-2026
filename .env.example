# Signs the stateless session tokens that gate every memory, chat and voice route.
# Must be at least 32 characters. With no secret set, all those routes reject every request.
# Generate one with:  node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
EMORI_SESSION_SECRET=

# Set to "on" to let the public demo mint anonymous visitor sessions on page load (the live
# Vercel deployment needs this plus EMORI_SESSION_SECRET). Leave unset/off everywhere else.
EMORI_DEMO_ACCESS=

# Optional rate-limit overrides, each as "limit:windowSeconds" (e.g. 30:60). If unset or malformed
# the built-in defaults apply. Limits are per-instance best-effort (see the README).
#   RATE_LIMIT_DEMO_MINT  default 10:600  — demo session mints per IP (proxy + /api/session/demo)
#   RATE_LIMIT_CHAT       default 30:60   — /api/chat, applied per IP AND per session user
#   RATE_LIMIT_VOICE      default 10:60   — /api/voice/transcribe per IP
RATE_LIMIT_DEMO_MINT=
RATE_LIMIT_CHAT=
RATE_LIMIT_VOICE=

# Choose one provider and use a current model ID from its model catalog.
AI_PROVIDER=openrouter
AI_MODEL=provider/model-id

# Set the key for the selected provider only.
OPENROUTER_API_KEY=
CRUSOE_API_KEY=

# Optional voice-to-text prototype using ElevenLabs Scribe v2.
ELEVENLABS_API_KEY=

# Optional Neo4j memory graph. Local database: `docker compose up -d`, then `npm run memory:seed`.
# The password below is the local-development default from docker-compose.yml.
# For AuraDB use the neo4j+s:// URI and credentials from the Aura console.
# REQUIRED after every deploy: run `npm run memory:seed -- --reset` against Aura, or the public demo
# graph will be blank (old seed rows have random ids and no tenant; they are hidden by design).
# --reset also purges legacy visitor-typed rows (fictional demo data).
# NEO4J_URI=bolt://localhost:7687
# NEO4J_USERNAME=neo4j
# NEO4J_PASSWORD=emori-local-dev
# NEO4J_DATABASE=

# Optional: point the compatible adapter at another endpoint or local test server.
# AI_BASE_URL=https://api.example.com/v1

# Optional OpenRouter attribution headers.
OPENROUTER_APP_NAME=Emori
APP_URL=http://localhost:3000
